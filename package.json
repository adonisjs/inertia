{
  "name": "@adonisjs/inertia",
  "description": "Official Inertia.js adapter for AdonisJS",
  "version": "4.0.0-next.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "build/index.js",
  "type": "module",
  "files": [
    "build"
  ],
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/src/types.js",
    "./services/main": "./build/services/inertia.js",
    "./inertia_middleware": "./build/src/inertia_middleware.js",
    "./inertia_provider": "./build/providers/inertia_provider.js",
    "./plugins/edge": "./build/src/plugins/edge/plugin.js",
    "./plugins/api_client": "./build/src/plugins/japa/api_client.js",
    "./client": "./build/src/plugins/vite.js",
    "./helpers": "./build/src/helpers.js"
  },
  "scripts": {
    "pretest": "npm run lint",
    "test": "cross-env NODE_DEBUG=adonisjs:inertia c8 npm run quick:test",
    "typecheck": "tsc --noEmit",
    "clean": "del-cli build",
    "compile": "tsup-node && tsc --emitDeclarationOnly --declaration",
    "copy:templates": "copyfiles --up 1 \"stubs/**/*.stub\" build",
    "prebuild": "npm run lint && npm run clean",
    "build": "npm run compile",
    "postbuild": "npm run copy:templates",
    "prebenchmark": "npm run build",
    "benchmark": "node benchmarks/index.js",
    "release": "release-it",
    "version": "npm run build",
    "format": "prettier --write .",
    "prepublishOnly": "npm run build",
    "lint": "eslint",
    "quick:test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.0.0-next.7",
    "@adonisjs/core": "^7.0.0-next.0",
    "@adonisjs/eslint-config": "^3.0.0-next.1",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/session": "^8.0.0-next.0",
    "@adonisjs/tsconfig": "^2.0.0-next.0",
    "@adonisjs/vite": "^5.0.1-next.0",
    "@japa/api-client": "^3.1.0",
    "@japa/assert": "4.1.1",
    "@japa/expect-type": "^2.0.3",
    "@japa/file-system": "^2.3.2",
    "@japa/plugin-adonisjs": "^5.0.0-next.0",
    "@japa/runner": "4.4.0",
    "@japa/snapshot": "^2.0.9",
    "@poppinss/ts-exec": "^1.4.1",
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/node": "^24.3.1",
    "@types/qs": "^6.14.0",
    "@types/supertest": "^6.0.3",
    "c8": "^10.1.3",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.0.0",
    "del-cli": "^6.0.0",
    "edge-parser": "^9.0.4",
    "edge.js": "^6.3.0",
    "eslint": "^9.35.0",
    "get-port": "^7.1.0",
    "prettier": "^3.6.2",
    "release-it": "^19.0.4",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.5"
  },
  "dependencies": {
    "@poppinss/utils": "^7.0.0-next.3",
    "@tuyau/utils": "^0.0.9",
    "edge-error": "^4.0.2",
    "html-entities": "^2.6.0",
    "locate-path": "^7.2.0",
    "qs": "^6.14.0"
  },
  "peerDependencies": {
    "@adonisjs/assembler": "^8.0.0-next.7",
    "@adonisjs/core": "^7.0.0-next.0",
    "@adonisjs/session": "^8.0.0-next.0",
    "@adonisjs/vite": "^5.0.1-next.0",
    "@japa/api-client": "^3.1.0",
    "@japa/plugin-adonisjs": "^5.0.0-next.0",
    "edge.js": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@japa/api-client": {
      "optional": true
    },
    "@japa/plugin-adonisjs": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Julien Ripouteau <julien@ripouteau.com>",
  "license": "MIT",
  "homepage": "https://github.com/adonisjs/inertia#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adonisjs/inertia.git"
  },
  "bugs": {
    "url": "https://github.com/adonisjs/inertia/issues"
  },
  "keywords": [
    "inertia",
    "adonisjs"
  ],
  "prettier": "@adonisjs/prettier-config",
  "release-it": {
    "git": {
      "requireUpstream": true,
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "push": true,
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "skipChecks": true,
      "tag": "latest"
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**",
      "tests_helpers/**"
    ]
  },
  "tsup": {
    "entry": [
      "./index.ts",
      "./src/types.ts",
      "./src/helpers.ts",
      "./src/plugins/vite.ts",
      "./services/inertia.ts",
      "./src/inertia_middleware.ts",
      "./providers/inertia_provider.ts",
      "./src/plugins/edge/plugin.ts",
      "./src/plugins/japa/api_client.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "dts": false,
    "sourcemaps": false,
    "target": "esnext"
  }
}
